                string[] data = lstData.SelectedItem.ToString().Split(" - ");

                txtName.Text = data[0];
                txtPhone.Text = data.Length > 1 ? data[1] : "";
                txtAddress.Text = data.Length > 2 ? data[2] : "";
            }
        }
